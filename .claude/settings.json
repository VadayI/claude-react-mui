{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Read(.env.example)",
      "Read(**/.env.example)",
      "Read(**/*.example)",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(bash scripts/:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.dev)",
      "Read(.env.development)",
      "Read(.env.prod)",
      "Read(.env.production)",
      "Read(.env.stage)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(.env.ci)",
      "Read(.env.docker)",
      "Read(.env.backup)",
      "Read(.env.bak)",
      "Read(.env.old)",
      "Read(.env.secret)",
      "Read(.env.secrets)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.stage)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.ci)",
      "Read(**/.env.docker)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(**/.env.old)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(.claude/settings.local.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials*)",
      "Read(secrets/**)"
    ]
  },
  "env": {
    "VITE_API_BASE_URL": "http://localhost:8000",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/policy/claude_edit_guard.mjs",
            "statusMessage": "Checking vendored contract edit policy..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${AI_PYTHON:-python3}\" \"$CLAUDE_PROJECT_DIR/scripts/ai/workdir.py\" --hook",
            "statusMessage": "Checking working directory (D17)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-start.mjs",
            "statusMessage": "Detecting environment..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AI_PYTHON:-python3}\" \"$CLAUDE_PROJECT_DIR/scripts/ai/workdir.py\" --hook",
            "statusMessage": "Checking working directory (D17)..."
          }
        ]
      }
    ]
  },
  "_last_reviewed": "2026-09-20"
}
