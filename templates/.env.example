# ---------------------------------------------------------------------------
# Environment variables for {PROJECT_NAME}
#
# Copy to .env and fill in the values for your local setup:
#   cp .env.example .env
#
# IMPORTANT: All variables MUST be prefixed with VITE_ — only VITE_ vars are
# exposed to the client bundle by Vite. DO NOT put secrets, tokens, or
# passwords here. This file is committed; .env is gitignored.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API (no trailing slash).
# Point to your local backend instance during development.
VITE_API_BASE_URL=http://localhost:8000

# External contract repo and pinned tag (Variant A multi-repo model).
# Update CONTRACT_VERSION when you pull a new schema pin.
CONTRACT_REPO=VadayI/claude-api-contract
CONTRACT_VERSION=v0.x.x  # Replace with the current pinned tag
