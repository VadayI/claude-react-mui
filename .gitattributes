# Force LF line endings across the repo, regardless of OS.
# Rationale: project lives on Windows + WSL2 and on a Debian VPS; bind-mounts
# between Windows and WSL2 routinely flip CRLF<->LF and produce phantom diffs.

* text=auto eol=lf

*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.pdf       binary
*.woff      binary
*.woff2     binary
