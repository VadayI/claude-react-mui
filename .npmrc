# ESLint 10 / TypeScript 6 peer-dep stopgap (PR A, plan 0004).
# Two transitive peers in the tree have not yet published ranges for the new majors:
#   - eslint-plugin-jsx-a11y@6.10.2 declares its eslint peer as ^3..^9 (no eslint 10).
#   - openapi-typescript@7.13.0 declares its typescript peer as ^5.x (no TypeScript 6).
# A strict install therefore ERESOLVEs against eslint@10 / typescript@6. legacy-peer-deps
# relaxes peer enforcement for BOTH `npm install` and `npm ci` (CI reads .npmrc).
# Tradeoff: peer-dependency mismatches are no longer hard errors tree-wide (a genuinely
# incompatible peer could slip in unnoticed) AND npm no longer auto-installs peer deps, so
# any peer the app actually imports must be declared as a direct dependency (e.g.
# @testing-library/dom, the peer of @testing-library/react). Revisit and remove once both
# plugins ship matching peer ranges (tracked in the upgrade ADR).
legacy-peer-deps=true
