# ---------------------------------------------------------------------------
# Environment for this project. Copy to .env and fill in:  cp .env.example .env
# All client-exposed vars MUST be prefixed VITE_. DO NOT put secrets/tokens here
# (.env.example is committed; .env is gitignored).
# ---------------------------------------------------------------------------

# API base URL — point to the Prism mock during early dev (4010), then staging backend.
VITE_API_BASE_URL=http://localhost:4010

# Contract pin — source of truth is YOUR contract repo, NOT the backend.
# Structured like the VadayI/claude-api-contract template.
CONTRACT_REPO=            # e.g. your-org/your-api-contract
CONTRACT_VERSION=         # pin a tag, e.g. v0.1.0

# MSW browser worker — 'true' to intercept API calls with mock handlers.
# Leave 'false' to run against VITE_API_BASE_URL (Prism or real backend).
# Playwright sets this automatically via webServer.env.
VITE_MSW_ENABLED=false

# ---------------------------------------------------------------------------
# Secrets — keep ONLY here in .env (gitignored). NEVER fill these in .env.example.
# Launch Claude via `make cc` (or `bash scripts/claude.sh`) so these reach the
# GitHub/Context7 MCP servers and the gh CLI — Claude Code does NOT auto-load .env.
# ---------------------------------------------------------------------------
# GitHub fine-grained PAT — Contents RW, Metadata RO, Pull requests RW, Workflows RW, Administration RW.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Context7 docs MCP API key (for the context7 MCP).
CONTEXT7_API_KEY=
